{
  "name": "grand-union",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "dev:web": "pnpm --filter @lts/web dev",
    "dev:scene": "pnpm --filter @lts/scene dev",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepare": "temple-bar hook install",
    "gate": "temple-bar gate",
    "ready": "temple-bar ready",
    "merge": "temple-bar merge"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@londontypescript/temple-bar": "0.2.0",
    "@types/node": "24.13.6",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "catalog:",
    "typescript-eslint": "8.70.1",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  }
}
