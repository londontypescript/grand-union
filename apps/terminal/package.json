  "dependencies": {
    "@lts/pages": "workspace:*",
    "@lts/renderer-ink": "workspace:*",
    "@lts/vocabulary": "workspace:*",
    "ink": "catalog:",
    "react": "catalog:",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "catalog:",
    "@types/ssh2": "1.15.6",
    "@xterm/headless": "6.0.0",
    "ink-testing-library": "4.0.0",
    "tsx": "4.23.15",
    "typescript": "catalog:"
  }
}
