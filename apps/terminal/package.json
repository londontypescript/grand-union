{
  "name": "@lts/terminal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:local": "tsx --tsconfig tsconfig.runtime.json src/local.tsx",
    "dev:server": "tsx --tsconfig tsconfig.runtime.json src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run --root ../.. --project unit apps/terminal/"
