{
  "name": "@lts/desktop",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node24 --external:electron --outfile=dist/main.js",
    "start": "electron dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run --root ../.. --project unit apps/desktop/"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "electron": "44.9.1",
    "esbuild": "0.28.2",
    "typescript": "catalog:"
  }
}
